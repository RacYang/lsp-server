# === 构建产物 ===
dist/
coverage.out

# 在项目根目录执行 go build ./cmd/<name> 时产生的临时二进制
# 正式构建输出到 dist/，此处仅防止本地调试产物被意外跟踪
/all
/bot
/cli
/gate
/loadgen
/lobby
/room

# === 开发环境 ===
tmp/
.cache/
.DS_Store
# 运行 scripts/ 下 Python enforcer 时生成的字节码缓存
__pycache__/

# === 本地配置（不入库）===
deploy/compose/.env
.claude/settings.local.json
.claude/memory/

# === 测试与压测产物 ===
bench/runs/
*.test
