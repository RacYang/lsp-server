server:
  addr: ":19082"
rule:
  default_id: "sichuan_xuezhandaodi_huansanzhang"
cluster:
  lobby_addr: "lobby:19081"
  room_addr: "room:19082"
  advertise_addr: "room:19082"
redis:
  addr: "redis:6379"
postgres:
  dsn: "postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"
obs:
  addr: ":19083"
etcd:
  endpoints: "etcd:2379"
runtime:
  gate:
    ws_rate_limit_per_second: 20
    ws_rate_limit_burst: 40
    ws_idempotency_cache: 4096
  room:
    mailbox_capacity: 96
  redis:
    idempotency_ttl: 10m
  postgres:
    pool:
      max_conns: 16
      min_conns: 0
      max_conn_lifetime: 1h
      max_conn_idle_time: 30m
      health_check_period: 1m
