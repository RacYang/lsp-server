{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaudeCodeRuleFrontmatter",
  "type": "object",
  "required": ["description"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "alwaysApply": {
      "type": "boolean",
      "const": true
    },
    "globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "not": {
    "required": ["alwaysApply", "globs"]
  }
}
