{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTemplateManifest",
  "type": "object",
  "required": ["id", "purpose", "applies_to_glob", "coverage_cell", "verify"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "applies_to_glob": {
      "type": "string",
      "minLength": 1
    },
    "coverage_cell": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9-]+$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pattern"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "pattern": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["presence", "regex", "script"] },
          "path": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "related_rules": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "related_skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
